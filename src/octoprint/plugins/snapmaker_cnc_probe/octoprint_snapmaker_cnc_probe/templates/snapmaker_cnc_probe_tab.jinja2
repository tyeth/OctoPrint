<div class="row-fluid" id="snapmaker_cnc_probe">
    <div class="span12">
        <h3>Snapmaker Probe and Alignment</h3>
        
        <div class="control-group">
            <button class="btn btn-primary" data-bind="click: captureMultiAngleImages, enable: !isBusy() && !isAnalyzing()">
                Capture Multi-Angle Images
            </button>
            <span data-bind="visible: isBusy" class="text-info">
                <i class="fa fa-spinner fa-spin"></i> Working...
            </span>
        </div>
        
        <div class="control-group">
            <label>Upload Fusion 360 Reference Image:</label>
            <input type="file" accept="image/*" data-bind="event: { change: uploadReferenceImage }, enable: !isBusy() && !isAnalyzing()">
        </div>
        
        <div class="control-group" data-bind="visible: hasImages() && hasFusionImage()">
            <button class="btn btn-info" data-bind="click: analyzeImages, enable: !isBusy() && !isAnalyzing()">
                Analyze Images
            </button>
            <span data-bind="visible: isAnalyzing" class="text-info">
                <i class="fa fa-spinner fa-spin"></i> Analyzing images... This may take a moment.
            </span>
        </div>
        
        <div class="control-group" data-bind="visible: hasAnalysisResult">
            <div class="alert alert-info">
                <h4>Analysis Results</h4>
                
                <!-- Model selection when both are available -->
                <div data-bind="visible: hasMultipleResults && hasOpusResult() && hasSonnetResult()">
                    <div class="btn-group" style="margin-bottom: 10px;">
                        <button class="btn" data-bind="click: function() { selectModel('opus'); }, css: {'btn-primary': selectedModel() === 'opus', 'active': selectedModel() === 'opus'}">
                            Claude 3 Opus Results
                        </button>
                        <button class="btn" data-bind="click: function() { selectModel('sonnet'); }, css: {'btn-primary': selectedModel() === 'sonnet', 'active': selectedModel() === 'sonnet'}">
                            Claude 3.7 Sonnet Results
                        </button>
                    </div>
                    <p><small>Compare results from both AI models to see which works better for your application</small></p>
                </div>
                
                <!-- Currently selected model info -->
                <p>Model used: <strong data-bind="text: selectedModel() === 'opus' ? 'Claude 3 Opus' : 'Claude 3.7 Sonnet'"></strong></p>
                <p>Required rotation angle: <strong data-bind="text: alignmentAngle().toFixed(2) + '°'"></strong></p>
                <p>Confidence level: <strong data-bind="text: (confidence() * 100).toFixed(0) + '%'"></strong></p>
                <p>Explanation: <span data-bind="text: explanation"></span></p>
                
                <div class="btn-group">
                    <button class="btn btn-success" data-bind="click: applyRotation, enable: !isBusy()">
                        Apply Rotation Correction
                    </button>
                    <button class="btn" data-bind="click: resetBAxis, enable: !isBusy()">
                        Reset B-Axis to Home
                    </button>
                </div>
            </div>
        </div>
        
        <div class="row-fluid" data-bind="visible: hasImages">
            <div class="span4" data-bind="with: image0Deg">
                <h4>0° Position</h4>
                <img data-bind="attr: { src: url }" style="max-width: 100%">
            </div>
            <div class="span4" data-bind="with: image120Deg">
                <h4>120° CCW Position</h4>
                <img data-bind="attr: { src: url }" style="max-width: 100%">
            </div>
            <div class="span4" data-bind="with: image60Deg">
                <h4>60° CW Position</h4>
                <img data-bind="attr: { src: url }" style="max-width: 100%">
            </div>
        </div>
        
        <div class="row-fluid" data-bind="visible: hasFusionImage">
            <div class="span12">
                <h4>Fusion 360 Reference</h4>
                <img data-bind="attr: { src: fusionImageUrl }" style="max-width: 100%">
            </div>
        </div>
    </div>
</div>