<h3>{{ _('Snapmaker CNC Probe Settings') }}</h3>

<form class="form-horizontal">
    <h4>{{ _('B-Axis & Camera Settings') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('Rotation Wait Time (seconds)') }}</label>
        <div class="controls">
            <input type="number" min="1" max="10" class="input-mini" data-bind="value: settings.plugins.snapmaker_cnc_probe.rotation_wait_time">
            <span class="help-block">{{ _('Time to wait after rotation before capturing image (seconds)') }}</span>
        </div>
    </div>
    
    <h4>{{ _('Digital Gauge Settings') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('Gauge Serial Port') }}</label>
        <div class="controls">
            <input type="text" class="input-large" data-bind="value: settings.plugins.snapmaker_cnc_probe.gauge_port">
            <span class="help-block">{{ _('Serial port for the digital gauge (e.g., /dev/ttyUSB0)') }}</span>
        </div>
    </div>
    
    <div class="control-group">
        <label class="control-label">{{ _('Gauge Baud Rate') }}</label>
        <div class="controls">
            <input type="number" class="input-medium" data-bind="value: settings.plugins.snapmaker_cnc_probe.gauge_baud">
            <span class="help-block">{{ _('Baud rate for serial communication (usually 9600)') }}</span>
        </div>
    </div>
    
    <h4>{{ _('LLM API Settings') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('API Key') }}</label>
        <div class="controls">
            <input type="password" class="input-large" data-bind="value: settings.plugins.snapmaker_cnc_probe.llm_api_key">
            <span class="help-block">{{ _('Your Anthropic API key for image analysis') }}</span>
        </div>
    </div>
    
    <div class="control-group">
        <label class="control-label">{{ _('API URL') }}</label>
        <div class="controls">
            <input type="text" class="input-large" data-bind="value: settings.plugins.snapmaker_cnc_probe.llm_api_url">
            <span class="help-block">{{ _('LLM API endpoint URL') }}</span>
        </div>
    </div>
    
    <div class="control-group">
        <label class="control-label">{{ _('Model Name') }}</label>
        <div class="controls">
            <input type="text" class="input-large" data-bind="value: settings.plugins.snapmaker_cnc_probe.llm_model">
            <span class="help-block">{{ _('The vision-capable model to use for image analysis') }}</span>
        </div>
    </div>
</form>